# PostgreSQL (owner role used ONLY by initialization/import scripts, never by the runtime query path)
POSTGRES_USER=itsm_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=itsm
POSTGRES_PORT=5432

# Read-only role used by the GraphJin runtime query path
GRAPHJIN_DB_USER=itsm_readonly
GRAPHJIN_DB_PASSWORD=change-me-readonly-local-only
GRAPHJIN_PORT=8081

# Local LLM (OpenAI-compatible llama.cpp endpoint) — feature 002
# The runtime query path uses ONLY this pinned local model. No fallback.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://your-local-llm-endpoint.example.internal/v1
LLM_MODEL=<EXACT_ID_FROM_/v1/models>
LLM_API_KEY=local-not-required
LLM_TEMPERATURE=0
LLM_CACHE=false

# GraphJin governed GraphQL endpoint (runtime query path)
GRAPHJIN_GRAPHQL_URL=http://127.0.0.1:8081/api/v1/graphql
