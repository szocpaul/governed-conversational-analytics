# PostgreSQL (owner role used ONLY by initialization/import scripts, never by the runtime query path)
POSTGRES_USER=itsm_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=itsm
POSTGRES_PORT=5432

# Read-only role used by the GraphJin runtime query path
GRAPHJIN_DB_USER=itsm_readonly
GRAPHJIN_DB_PASSWORD=change-me-readonly-local-only
GRAPHJIN_PORT=8081
