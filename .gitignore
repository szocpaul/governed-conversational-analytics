# Prime Agent session data (project skills live in ./skills/ and are symlinked in)
.prime/

# Local secrets
.env

# GraphJin container-managed state (artifact SQLite, discovery snapshots)
graphjin/config/.graphjin/

# Python bytecode
__pycache__/
*.pyc

# Feature 009: transient generation checkpoint (append-only resume state).
# Deleted on successful completion; never committed — the pinned artifact is
# data/raw/tickets_texts.jsonl. (Local sample outputs use /tmp, no rule needed.)
artifacts/tickets_texts.checkpoint.jsonl

# Feature 010: transient embedding checkpoint (append-only resume state).
# Deleted on successful completion; never committed — the pinned artifact is
# data/raw/tickets_embeddings.jsonl. (Local sample outputs use /tmp, no rule needed.)
artifacts/tickets_embeddings.checkpoint.jsonl
