{
  "scanners": [
    {
      "id": "javascript",
      "source": "@groma/scanner-javascript@0.2.2",
      "include": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.min.js",
        "*.min.mjs",
        "*.min.cjs",
        "*.min.jsx",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "python",
      "source": "@groma/scanner-python@0.2.2",
      "include": [
        "**/*.py",
        "**/pyproject.toml",
        "**/setup.cfg",
        "**/requirements.txt"
      ],
      "exclude": [
        ".venv/",
        "venv/",
        "__pycache__/",
        "test/",
        "tests/",
        "test_*.py",
        "*_test.py",
        "conftest.py",
        "build/",
        "dist/",
        "/tests/"
      ]
    }
  ]
}